<!-- Moff - Restructured into Identity / Appearance / Loadouts / Roles / Traits tabs. -->
<BoxContainer xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
         xmlns:profileEditorControls="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:dvTraitUi="clr-namespace:Content.Client._DV.Traits.UI"
         xmlns:moffLoadouts="clr-namespace:Content.Client._Moffstation.Lobby.UI.Loadouts"
         xmlns:moffRoles="clr-namespace:Content.Client._Moffstation.Lobby.UI.Roles"
         HorizontalExpand="True"
         VerticalExpand="True">

    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10"
                  SeparationOverride="8">

        <!-- Profile-wide actions -->
        <PanelContainer StyleClasses="MoffProfileHeader">
            <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <Label Text="{Loc 'moff-profile-editing-title'}"
                       StyleClasses="MoffProfileTitle"
                       VAlign="Center"
                       HorizontalExpand="True" />

                <Button Name="SaveButton"
                        Text="{Loc 'humanoid-profile-editor-save-button'}"
                        StyleClasses="positive" />

                <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" />
                <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" />

                <cc:VSeparator Margin="8 2" />

                <controls:ConfirmButton Name="ResetButton"
                                        Disabled="True"
                                        Text="{Loc 'humanoid-profile-editor-reset-button'}"
                                        ConfirmationText="{Loc 'moff-profile-confirm-reset'}"
                                        StyleClasses="negative" />
            </BoxContainer>
        </PanelContainer>

        <TabContainer Name="TabContainer" HorizontalExpand="True" VerticalExpand="True">

            <!-- 0: Identity -->
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              Margin="12"
                              SeparationOverride="10">

                    <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                            <PanelContainer StyleClasses="MoffProfileHeader">
                                <Label Text="{Loc 'humanoid-profile-editor-identity-tab'}"
                                       StyleClasses="MoffProfileTitle" />
                            </PanelContainer>

                            <!-- Name -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-name-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <LineEdit Name="NameEdit" MinWidth="270" MaxWidth="420" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <RichTextLabel Name="WarningLabel"
                                           HorizontalExpand="False"
                                           MaxWidth="425"
                                           HorizontalAlignment="Left" />

                            <!-- Age -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-age-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <LineEdit Name="AgeEdit" MinWidth="80" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Species -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-species-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <OptionButton Name="SpeciesButton" MinWidth="220" MaxWidth="320" />
                                <TextureButton Name="SpeciesInfoButton"
                                               Scale="0.3 0.3"
                                               VerticalAlignment="Center"
                                               ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Pronouns -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <OptionButton Name="PronounsButton" MinWidth="220" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Voice -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-voice-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <OptionButton Name="VoiceButton" MinWidth="220" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Spawn priority -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <OptionButton Name="SpawnPriorityButton" MinWidth="220" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- Randomizer -->
                    <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                            <PanelContainer StyleClasses="MoffProfileHeader">
                                <Label Text="{Loc 'humanoid-profile-editor-randomize'}"
                                       StyleClasses="MoffProfileTitle" />
                            </PanelContainer>

                            <GridContainer Columns="4" HorizontalExpand="True">
                                <ui:RandomizeLockButton For="Name" LabelText="{Loc 'humanoid-profile-editor-randomize-name-button'}"/>
                                <ui:RandomizeLockButton For="Species" LabelText="{Loc 'humanoid-profile-editor-randomize-species-button'}"/>
                                <ui:RandomizeLockButton For="Age" LabelText="{Loc 'humanoid-profile-editor-randomize-age-button'}"/>
                                <ui:RandomizeLockButton For="Sex" LabelText="{Loc 'humanoid-profile-editor-randomize-sex-button'}"/>
                                <ui:RandomizeLockButton For="Skin" LabelText="{Loc 'humanoid-profile-editor-randomize-skin-button'}"/>
                                <ui:RandomizeLockButton For="Eyes" LabelText="{Loc 'humanoid-profile-editor-randomize-eye-button'}"/>
                                <!-- Moff Start - Buttons for our shit -->
                                <ui:RandomizeLockButton For="Height" LabelText="{Loc 'humanoid-profile-editor-randomize-height-button'}"/>
                                <!-- Moff end -->
                                <ui:RandomizeLockButton For="Markings" LabelText="{Loc 'humanoid-profile-editor-randomize-markings-button'}"/>
                            </GridContainer>

                            <Button Name="RandomizeUnlockedButton"
                                    MaxWidth="256"
                                    Text="{Loc 'humanoid-profile-editor-randomize-unlocked-button'}"/>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- Flavor text, shown only when the server allows it -->
                    <PanelContainer Name="FlavorTextSection"
                                    StyleClasses="MoffProfileCard"
                                    HorizontalExpand="True"
                                    Visible="False">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                            <PanelContainer StyleClasses="MoffProfileHeader">
                                <Label Text="{Loc 'humanoid-profile-editor-flavortext-tab'}"
                                       StyleClasses="MoffProfileTitle" />
                            </PanelContainer>

                            <BoxContainer Name="FlavorTextContainer"
                                          Orientation="Vertical"
                                          HorizontalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>

            <!-- 1: Appearance -->
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              Margin="12"
                              SeparationOverride="10">

                    <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                            <PanelContainer StyleClasses="MoffProfileHeader">
                                <Label Text="{Loc 'moff-profile-body-section'}" StyleClasses="MoffProfileTitle" />
                            </PanelContainer>

                            <!-- Species -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-species-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <OptionButton Name="AppearanceSpeciesButton" MinWidth="220" MaxWidth="320" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Sex -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-sex-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <OptionButton Name="SexButton" MinWidth="220" />
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- CD Height -->
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-height-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />
                                <Slider Name="CDHeightSlider" SetWidth="300" MinValue="0.0" MaxValue="1.0"/>
                                <LineEdit Name="CDHeight" MinSize="60 0" Text="1.0" />
                                <Button Name="CDHeightReset" Text="{Loc 'humanoid-profile-editor-reset-height-button'}"/>
                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <PanelContainer StyleClasses="LowDivider" MinHeight="1" Margin="0 4" />

                            <!-- Skin color -->
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                                <Slider Name="Skin" HorizontalExpand="True" MinValue="0" MaxValue="100" Value="20" />
                                <BoxContainer Name="RgbSkinColorContainer"
                                              Visible="False"
                                              Orientation="Vertical"
                                              HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Eye color -->
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                                <humanoid:EyeColorPicker Name="EyeColorPicker" HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- Markings -->
                    <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="7">
                            <PanelContainer StyleClasses="MoffProfileHeader">
                                <Label Text="{Loc 'humanoid-profile-editor-markings-tab'}"
                                       StyleClasses="MoffProfileTitle" />
                            </PanelContainer>

                            <humanoid:MarkingPicker Name="Markings" HorizontalExpand="True" MinHeight="600" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>

            <!-- 2: Loadouts -->
            <moffLoadouts:MoffLoadoutEditor Name="LoadoutEditor" HorizontalExpand="True" VerticalExpand="True" />

            <!-- 3: Roles (jobs + the fork's antag tab) -->
            <moffRoles:MoffRolesEditor Name="RolesEditor" HorizontalExpand="True" VerticalExpand="True" />

            <!-- 4: Traits -->
            <dvTraitUi:TraitsTab Name="Traits" />
        </TabContainer>
    </BoxContainer>

    <!-- Character preview -->
    <PanelContainer StyleClasses="MoffProfilePreview" MinWidth="260" Margin="0 10 10 10">
        <BoxContainer Orientation="Vertical"
                      VerticalExpand="True"
                      VerticalAlignment="Center"
                      SeparationOverride="8">

            <profileEditorControls:ProfilePreviewSpriteView Name="SpriteView"
                                                           Scale="8 8"
                                                           Margin="4"
                                                           SizeFlagsStretchRatio="1" />

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="4">
                <Button Name="SpriteRotateLeft" Text="◀" StyleClasses="OpenRight" />
                <cc:VSeparator Margin="2 0" />
                <Button Name="SpriteRotateRight" Text="▶" StyleClasses="OpenLeft" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" MinHeight="1" Margin="12 6" />

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="10">
                <Label Text="{Loc 'moff-profile-preview-clothing'}"
                       StyleClasses="MoffLobbyMuted"
                       VAlign="Center" />
                <controls:SwitchButton Name="ShowClothes" Pressed="True" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" MinHeight="1" Margin="12 6" />

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="5">
                <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" />
                <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
