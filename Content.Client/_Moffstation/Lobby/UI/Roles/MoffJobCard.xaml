<roles:MoffJobCard
    xmlns="https://spacestation14.io"
    xmlns:roles="clr-namespace:Content.Client._Moffstation.Lobby.UI.Roles"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    HorizontalExpand="True"
    MinWidth="280"
    StyleClasses="MoffJobCard">

    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  SeparationOverride="7">

        <!-- Icon / title / toggle -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
            <PanelContainer StyleClasses="MoffJobIcon" MinSize="32 32" VerticalAlignment="Center">
                <TextureRect Name="JobIcon" MinSize="32 32" Stretch="KeepAspectCentered" />
            </PanelContainer>

            <ContainerButton Name="GuidebookButton"
                             StyleClasses="MoffJobTitleButton"
                             HorizontalExpand="True"
                             VerticalAlignment="Center">
                <Label Name="JobName"
                       StyleClasses="MoffJobName"
                       HorizontalExpand="True"
                       ClipText="True"
                       MouseFilter="Ignore" />
            </ContainerButton>

            <controls:SwitchButton Name="PreferenceToggle"
                                   OffStateText=""
                                   OnStateText=""
                                   VerticalAlignment="Center" />

            <Button Name="LoadoutButton"
                    Text="{Loc 'moff-roles-loadout-button'}"
                    VerticalAlignment="Center" />
        </BoxContainer>

        <!-- Description -->
        <PanelContainer Name="DescriptionPanel"
                        StyleClasses="MoffJobDescriptionPanel"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        MinHeight="72">
            <RichTextLabel Name="JobDescription"
                           HorizontalExpand="True"
                           VerticalExpand="True"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           MaxWidth="500" />
        </PanelContainer>
    </BoxContainer>
</roles:MoffJobCard>
