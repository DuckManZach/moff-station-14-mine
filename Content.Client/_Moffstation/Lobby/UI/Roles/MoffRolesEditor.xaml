<roles:MoffRolesEditor
    xmlns="https://spacestation14.io"
    xmlns:roles="clr-namespace:Content.Client._Moffstation.Lobby.UI.Roles"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:moffAntagUi="clr-namespace:Content.Client._Moffstation.Antags.UI"
    HorizontalExpand="True"
    VerticalExpand="True">

    <TabContainer Name="RolesTabContainer" HorizontalExpand="True" VerticalExpand="True">

        <!-- Jobs -->
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="8"
                      SeparationOverride="8">

            <!-- Hidden: superseded by the player-global job priority editor, but kept so the setting still loads. -->
            <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                    <Label Text="{Loc 'moff-roles-unavailable-label'}" VerticalAlignment="Center" />

                    <OptionButton Name="PreferenceUnavailableButton"
                                  Access="Public"
                                  MinWidth="220"
                                  MaxWidth="300" />

                    <Control HorizontalExpand="True" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                    <ContainerButton Name="EnabledJobsHeader" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      SeparationOverride="7"
                                      MouseFilter="Ignore">
                            <Label Name="EnabledJobsChevron" Text="▶" />

                            <Label Text="{Loc 'moff-roles-enabled-jobs'}"
                                   StyleClasses="MoffProfileTitle"
                                   HorizontalExpand="True" />

                            <Label Name="EnabledJobsCount" Text="0" />
                        </BoxContainer>
                    </ContainerButton>

                    <PanelContainer Name="EnabledJobsPanel" Visible="False" HorizontalExpand="True">
                        <BoxContainer Name="EnabledJobsList" Orientation="Vertical" HorizontalExpand="True" />
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="MoffProfileCard" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8">
                    <LineEdit Name="JobSearch"
                              PlaceHolder="{Loc 'moff-roles-search-placeholder'}"
                              HorizontalExpand="True" />

                    <Button Name="JobSearchClearButton" Text="{Loc 'moff-ui-clear'}" Disabled="True" />

                    <OptionButton Name="JobDepartmentFilter" MinWidth="220" />

                    <Label Text="{Loc 'moff-ui-selected-only'}" VerticalAlignment="Center" />

                    <controls:SwitchButton Name="JobSelectedOnly"
                                           OffStateText=""
                                           OnStateText=""
                                           VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>

            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="JobList" Orientation="Vertical" HorizontalExpand="True" />
            </ScrollContainer>
        </BoxContainer>

        <!-- Antagonists: the fork's existing tab, reused as-is. -->
        <moffAntagUi:SpecialRolesTab Name="Antags" Access="Public" />
    </TabContainer>
</roles:MoffRolesEditor>
