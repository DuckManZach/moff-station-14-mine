<loadouts:MoffLoadoutItemCard
    xmlns="https://spacestation14.io"
    xmlns:loadouts="clr-namespace:Content.Client._Moffstation.Lobby.UI.Loadouts"
    ToggleMode="True"
    HorizontalExpand="True"
    MinWidth="96"
    MinHeight="96"
    StyleClasses="MoffLoadoutItemCard">

    <PanelContainer StyleClasses="MoffLoadoutCard"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    MouseFilter="Ignore">

        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="5"
                      SeparationOverride="3"
                      MouseFilter="Ignore">

            <Label Name="CostLabel"
                   Text="0"
                   HorizontalAlignment="Left"
                   StyleClasses="MoffProfileTitle"
                   MouseFilter="Ignore" />

            <SpriteView Name="ItemSprite"
                        SetSize="67 67"
                        Scale="12 12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        VerticalExpand="True"
                        MouseFilter="Ignore" />

            <Label Name="ItemNameLabel"
                   Text="Item"
                   SetWidth="135"
                   HorizontalAlignment="Center"
                   Align="Center"
                   ClipText="True"
                   MouseFilter="Ignore" />
        </BoxContainer>
    </PanelContainer>
</loadouts:MoffLoadoutItemCard>
