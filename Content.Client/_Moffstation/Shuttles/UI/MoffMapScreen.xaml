<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
              Visible="False"
              HorizontalExpand="True">
    <ui:ShuttleMapControl Name="MapRadar"
                          MouseFilter="Stop"
                          Margin="5 4 10 5"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          VerticalAlignment="Stretch"/>
    <BoxContainer Name="RightDisplayMap"
                  HorizontalAlignment="Right"
                  MinWidth="256"
                  MaxWidth="256"
                  Margin="5 0 5 5"
                  Orientation="Vertical"
                  VerticalExpand="True">
        <controls:StripeBack MinSize="48 48">
            <Label Text="{Loc 'shuttle-console-ftl-label'}"
                   VerticalExpand="True"
                   HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <Label Name="MapFTLState"
               Text="{Loc 'shuttle-console-ftl-state-Available'}"
               HorizontalAlignment="Center"/>
        <ProgressBar Name="FTLBar"
                     HorizontalExpand="True"
                     Margin="5"
                     MinValue="0.0"
                     MaxValue="1.0"
                     Value="1.0"/>
        <Label Name="RiftStatus"
               Text="{Loc 'shuttle-console-outside-rift'}"
               StyleClasses="negative"
               HorizontalAlignment="Center"
               Visible="False"/>
        <controls:StripeBack MinSize="48 48">
            <Label Text="{Loc 'shuttle-console-sectors'}"
                   VerticalExpand="True"
                   HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <ScrollContainer VerticalExpand="True"
                         HScrollEnabled="False">
            <BoxContainer Name="SectorList"
                          Orientation="Vertical"
                          HorizontalExpand="True"/>
        </ScrollContainer>
        <Label Name="NoSectorsLabel"
               Text="{Loc 'shuttle-console-no-sectors'}"
               StyleClasses="LabelWeak"
               HorizontalAlignment="Center"
               Visible="False"/>
        <Button Name="WarpButton"
                Text="{Loc 'shuttle-console-warp'}"
                StyleClasses="ButtonBig"
                MinHeight="48"
                Margin="0 5 0 0"
                Disabled="True"/>
    </BoxContainer>
</BoxContainer>
