<ui:MoffSectorScreen xmlns="https://spacestation14.io"
                     xmlns:ui="clr-namespace:Content.Client._Moffstation.Shuttles.UI"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:parallax="clr-namespace:Content.Client.Parallax"
                     Visible="False"
                     HorizontalExpand="True">
    <!-- Parallax is a sibling behind the radar rather than something the radar draws: children render on top of
         their parent, so it can't be nested, and this reuses ParallaxControl instead of a fourth copy of the tiler. -->
    <Control Margin="5 4 10 5"
             HorizontalExpand="True"
             VerticalExpand="True">
        <parallax:ParallaxControl Name="SectorParallax"/>
        <ui:MoffSectorMapControl Name="SectorRadar"
                                 MouseFilter="Stop"
                                 HorizontalExpand="True"
                                 VerticalExpand="True"
                                 VerticalAlignment="Stretch"/>
    </Control>
    <BoxContainer VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  MinWidth="256"
                  MaxWidth="256"
                  Margin="5 0 5 5"
                  Orientation="Vertical"
                  VerticalExpand="True">
        <controls:StripeBack MinSize="48 48">
            <Label Text="{Loc 'shuttle-console-ftl-label'}"
                   VerticalExpand="True"
                   HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <Label Name="FTLStateLabel"
               Text="{Loc 'shuttle-console-ftl-state-Available'}"
               HorizontalAlignment="Center"/>
        <ProgressBar Name="FTLBar"
                     HorizontalExpand="True"
                     Margin="5"
                     MinValue="0.0"
                     MaxValue="1.0"
                     Value="1.0"/>
        <Button Name="FTLButton"
                Text="{Loc 'shuttle-console-sector-ftl'}"
                TextAlign="Center"
                Disabled="True"/>
        <Label Name="FTLReasonLabel"
               Text="{Loc 'shuttle-console-ftl-zone'}"
               HorizontalAlignment="Center"
               Visible="False"/>
        <controls:ConfirmButton Name="ExitSectorButton"
                                Text="{Loc 'shuttle-console-exit-sector'}"
                                ConfirmationText="{Loc 'shuttle-console-exit-sector-confirm'}"
                                Visible="False"
                                Margin="0 4 0 0"/>
        <controls:StripeBack MinSize="48 48">
            <Label Text="{Loc 'shuttle-console-sectors'}"
                   HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <ScrollContainer VerticalExpand="True"
                         HScrollEnabled="False"
                         ReturnMeasure="True">
            <BoxContainer Name="SectorList"
                          Orientation="Vertical"
                          VerticalExpand="True"/>
        </ScrollContainer>
    </BoxContainer>
</ui:MoffSectorScreen>
