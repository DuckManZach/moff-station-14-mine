<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              Orientation="Vertical"
              SeparationOverride="10">
    <Label
        Name="NoPatientPlaceholder"
        Text="{Loc health-analyzer-window-no-patient-data-text}"
        HorizontalExpand="True"
        VerticalExpand="True"
        Align="Center"/>

    <BoxContainer Name="MainContent" Orientation="Horizontal" SeparationOverride="10" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" MinWidth="240" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <PanelContainer SetSize="64 64">
                    <SpriteView OverrideDirection="South" Scale="2 2" Name="PatientView" SetSize="64 64" />
                    <TextureRect Name="OutOfRange" Access="Public" SetSize="64 64" Visible="false" Stretch="KeepAspectCentered" TexturePath="/Textures/Interface/Misc/health_analyzer_out_of_range.png"/>
                </PanelContainer>
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <Label Name="NameLabel" />
                    <Label Name="SpeciesLabel" VerticalAlignment="Top" StyleClasses="LabelSubText" />
                </BoxContainer>
            </BoxContainer>

            <controls:Separator StyleClasses="LowDivider" />

            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'offbrand-vitals-pain'}" HorizontalExpand="True" />
                <Label Name="PainValue" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'offbrand-vitals-brain-activity'}" HorizontalExpand="True" />
                <Label Name="BrainActivityValue" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Name="SpO2Label" HorizontalExpand="True" />
                <Label Name="SpO2Value" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'offbrand-vitals-respiratory-rate'}" HorizontalExpand="True" />
                <Label Name="RespiratoryRateValue" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Name="EtCO2Label" HorizontalExpand="True" />
                <Label Name="EtCO2Value" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'offbrand-vitals-blood-pressure'}" HorizontalExpand="True" />
                <Label Name="BloodPressureValue" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'offbrand-vitals-blood-volume'}" HorizontalExpand="True" />
                <Label Name="BloodVolumeValue" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'offbrand-vitals-heart-rate'}" HorizontalExpand="True" />
                <Label Name="HeartRateValue" />
            </BoxContainer>
        </BoxContainer>

        <PanelContainer Name="BodyPartsPanel" StyleClasses="PanelDark" MinSize="360 300" HorizontalExpand="True" VerticalExpand="True">
            <Label Name="NoInjuries"
                   Text="{Loc health-analyzer-window-no-patient-damages}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   StyleClasses="LabelSubText" />
            <ScrollContainer HScrollEnabled="False">
                <BoxContainer Name="BodyPartRows" Orientation="Vertical" />
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</BoxContainer>
